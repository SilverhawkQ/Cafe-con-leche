---
import PuckScene from '../components/PuckScene.tsx';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Espresso Dialer</title>
		<meta name="description" content="Interactive espresso dial-in tool: change dose, yield, time, temperature and grind and see how the shot changes." />
		<meta name="theme-color" content="#FFF8EE" />
		<meta property="og:title" content="Espresso Dialer" />
		<meta property="og:description" content="Dial in your espresso with an interactive cartoon portafilter." />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<PuckScene client:only="react" />
	</body>
</html>
